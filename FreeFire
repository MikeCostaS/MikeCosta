#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_COMP 20
#define NOME_SZ 30
#define TIPO_SZ 20

typedef struct {
    char nome[NOME_SZ];
    char tipo[TIPO_SZ];
    int prioridade;
} Componente;

/* ---------------- utilitários ---------------- */

/* Remove o '\n' final deixado por fgets */
void trim_newline(char *s) {
    size_t L = strlen(s);
    if (L == 0) return;
    if (s[L-1] == '\n') s[L-1] = '\0';
}

/* Mostra os componentes formatados */
void mostrarComponentes(Componente v[], int n) {
    printf("\n--- Componentes (total: %d) ---\n", n);
    printf("%-3s | %-28s | %-18s | %-9s\n", "Idx", "Nome", "Tipo", "Prioridade");
    printf("----+------------------------------+--------------------+-----------\n");
    for (int i = 0; i < n; ++i) {
        printf("%3d | %-28s | %-18s | %9d\n", i, v[i].nome, v[i].tipo, v[i].prioridade);
    }
    printf("-------------------------------\n");
}

/* Faz cópia de vetor (útil para manter original) */
void copiaVetor(Componente src[], Componente dst[], int n) {
    for (int i = 0; i < n; ++i) dst[i] = src[i];
}

/* ---------------- medidas de tempo ----------------
   Padronizamos a assinatura de algoritmo de ordenação:
   void alg(Componente v[], int n, long long *comparacoes)
*/
typedef void (*AlgSort)(Componente[], int, long long*);

/* medirTempo: executa o algoritmo sobre uma cópia do vetor,
   retorna comparações e tempo em segundos. */
void medirTempo(AlgSort algoritmo, Componente dados[], int n, long long *comparacoes, double *segundos) {
    Componente tmp[MAX_COMP];
    copiaVetor(dados, tmp, n);
    clock_t inicio = clock();
    *comparacoes = 0;
    algoritmo(tmp, n, comparacoes);
    clock_t fim = clock();
    *segundos = (double)(fim - inicio) / CLOCKS_PER_SEC;
    /* Após medir, atualizar dados[] com resultado ordenado (opcional) */
    copiaVetor(tmp, dados, n);
}

/* ---------------- algoritmos de ordenação ---------------- */

/* Bubble sort por nome (alfabético). Conta comparações de string.
   Critério: strcmp > 0 -> troca para ordem ascendente. */
void bubbleSortNome(Componente v[], int n, long long *comparacoes) {
    int trocou;
    for (int i = 0; i < n - 1; ++i) {
        trocou = 0;
        for (int j = 0; j < n - 1 - i; ++j) {
            (*comparacoes)++;
            if (strcmp(v[j].nome, v[j+1].nome) > 0) {
                Componente tmp = v[j];
                v[j] = v[j+1];
                v[j+1] = tmp;
                trocou = 1;
            }
        }
        if (!trocou) break;
    }
}

/* Insertion sort por tipo (string). Ordena por tipo ascendente; 
   em caso de empate, mantém ordem estável (não altera). */
void insertionSortTipo(Componente v[], int n, long long *comparacoes) {
    for (int i = 1; i < n; ++i) {
        Componente chave = v[i];
        int j = i - 1;
        while (j >= 0) {
            (*comparacoes)++;
            if (strcmp(v[j].tipo, chave.tipo) > 0) {
                v[j+1] = v[j];
                j--;
            } else {
                break;
            }
        }
        v[j+1] = chave;
    }
}

/* Selection sort por prioridade (int).
   Ordena por prioridade ascendente (1 .. 10). Conta comparações inteiras. */
void selectionSortPrioridade(Componente v[], int n, long long *comparacoes) {
    for (int i = 0; i < n - 1; ++i) {
        int idxMin = i;
        for (int j = i + 1; j < n; ++j) {
            (*comparacoes)++;
            if (v[j].prioridade < v[idxMin].prioridade) {
                idxMin = j;
            }
        }
        if (idxMin != i) {
            Componente tmp = v[i];
            v[i] = v[idxMin];
            v[idxMin] = tmp;
        }
    }
}

/* ---------------- busca binária por nome ----------------
   Retorna índice se encontrado, -1 caso contrário.
   Conta comparações (strcmp calls considered as 1 comparison)
*/
int buscaBinariaPorNome(Componente v[], int n, char chave[], long long *comparacoes) {
    int low = 0, high = n - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        (*comparacoes)++;
        int cmp = strcmp(v[mid].nome, chave);
        if (cmp == 0) return mid;
        else if (cmp < 0) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

/* ---------------- função para cadastrar componentes ---------------- */
int cadastrarComponentes(Componente comps[]) {
    int n = 0;
    char buffer[100];
    printf("Quantos componentes deseja cadastrar? (1-%d): ", MAX_COMP);
    if (!fgets(buffer, sizeof(buffer), stdin)) return 0;
    n = atoi(buffer);
    if (n < 1) n = 1;
    if (n > MAX_COMP) n = MAX_COMP;

    for (int i = 0; i < n; ++i) {
        printf("\nComponente %d:\n", i+1);
        printf(" Nome (ex: chip central): ");
        if (!fgets(comps[i].nome, NOME_SZ, stdin)) comps[i].nome[0] = '\0';
        trim_newline(comps[i].nome);

        printf(" Tipo (ex: controle, suporte, propulsao): ");
        if (!fgets(comps[i].tipo, TIPO_SZ, stdin)) comps[i].tipo[0] = '\0';
        trim_newline(comps[i].tipo);

        int p = 0;
        while (1) {
            printf(" Prioridade (1-10): ");
            if (!fgets(buffer, sizeof(buffer), stdin)) { p = 1; break; }
            p = atoi(buffer);
            if (p >= 1 && p <= 10) break;
            printf("  Prioridade inválida. Digite entre 1 e 10.\n");
        }
        comps[i].prioridade = p;
    }
    return n;
}

/* ---------------- menu interativo e lógica ---------------- */
int main() {
    Componente comps[MAX_COMP];
    Componente working[MAX_COMP];
    int n = 0;
    int sortedByName = 0;  /* flag para saber se vetor atual está ordenado por nome */

    printf("=== Torre de Resgate: Módulo de Priorização e Montagem ===\n");

    /* cadastrar inicialmente */
    n = cadastrarComponentes(comps);
    copiaVetor(comps, working, n);

    int escolha;
    char buffer[128];
    long long comparacoes;
    double tempo;

    while (1) {
        printf("\nMenu:\n");
        printf(" 1 - Mostrar componentes atuais\n");
        printf(" 2 - Ordenar por NOME (Bubble Sort)\n");
        printf(" 3 - Ordenar por TIPO (Insertion Sort)\n");
        printf(" 4 - Ordenar por PRIORIDADE (Selection Sort)\n");
        printf(" 5 - Busca binária por NOME (apenas se ordenado por nome)\n");
        printf(" 6 - Re-cadastrar componentes (substitui lista)\n");
        printf(" 0 - Sair\n");
        printf("Escolha: ");
        if (!fgets(buffer, sizeof(buffer), stdin)) break;
        escolha = atoi(buffer);

        if (escolha == 0) {
            printf("Saindo... boa sorte na fuga!\n");
            break;
        }

        switch (escolha) {
            case 1:
                mostrarComponentes(working, n);
                break;

            case 2: /* Bubble sort por nome */
                copiaVetor(comps, working, n); /* trabalhar sobre a cópia atual dos originais */
                medirTempo(bubbleSortNome, working, n, &comparacoes, &tempo);
                printf("\n[Bubble Sort por NOME] Comparacoes = %lld, Tempo = %.6f s\n", comparacoes, tempo);
                mostrarComponentes(working, n);
                sortedByName = 1;
                break;

            case 3: /* Insertion por tipo */
                copiaVetor(comps, working, n);
                medirTempo(insertionSortTipo, working, n, &comparacoes, &tempo);
                printf("\n[Insertion Sort por TIPO] Comparacoes = %lld, Tempo = %.6f s\n", comparacoes, tempo);
                mostrarComponentes(working, n);
                sortedByName = 0;
                break;

            case 4: /* Selection por prioridade */
                copiaVetor(comps, working, n);
                medirTempo(selectionSortPrioridade, working, n, &comparacoes, &tempo);
                printf("\n[Selection Sort por PRIORIDADE] Comparacoes = %lld, Tempo = %.6f s\n", comparacoes, tempo);
                mostrarComponentes(working, n);
                sortedByName = 0;
                break;

            case 5: /* Busca binária por nome */
                if (!sortedByName) {
                    printf("ATENCAO: a busca binaria exige que os componentes estejam ordenados por NOME.\n");
                    printf(" Deseja ordenar agora por NOME e então buscar? (s/n): ");
                    if (!fgets(buffer, sizeof(buffer), stdin)) break;
                    trim_newline(buffer);
                    if (buffer[0] == 's' || buffer[0] == 'S') {
                        copiaVetor(comps, working, n);
                        /* ordenar (e medir) */
                        medirTempo(bubbleSortNome, working, n, &comparacoes, &tempo);
                        printf("\n[Bubble Sort por NOME] Comparacoes = %lld, Tempo = %.6f s\n", comparacoes, tempo);
                        sortedByName = 1;
                        mostrarComponentes(working, n);
                    } else {
                        printf("Busca cancelada. Ordene por nome antes de usar busca binária.\n");
                        break;
                    }
                }

                /* receber termo de busca */
                printf("Digite o NOME do componente-chave a buscar (exato): ");
                if (!fgets(buffer, sizeof(buffer), stdin)) break;
                trim_newline(buffer);
                long long compBusca = 0;
                clock_t ini = clock();
                int idx = buscaBinariaPorNome(working, n, buffer, &compBusca);
                clock_t fim = clock();
                double tempoBusca = (double)(fim - ini)/CLOCKS_PER_SEC;
                if (idx >= 0) {
                    printf("\nComponente encontrado no índice %d.\n", idx);
                    printf("Detalhes: Nome: %s | Tipo: %s | Prioridade: %d\n", working[idx].nome, working[idx].tipo, working[idx].prioridade);
                } else {
                    printf("\nComponente '%s' NÃO encontrado na lista.\n", buffer);
                }
                printf("[Busca Binária] Comparacoes = %lld, Tempo = %.6f s\n", compBusca, tempoBusca);
                break;

            case 6:
                n = cadastrarComponentes(comps);
                copiaVetor(comps, working, n);
                sortedByName = 0;
                break;

            default:
                printf("Opcao invalida. Tente novamente.\n");
                break;
        }
    }

    return 0;
}
